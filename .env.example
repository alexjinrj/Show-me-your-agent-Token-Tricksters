# Configuration reference: export values; the API does not automatically load .env.
# Backend Gateway token: never put this in frontend code.
BC_OPENCLAW_URL=http://127.0.0.1:18789
BC_OPENCLAW_TOKEN=YOUR_GATEWAY_TOKEN
BC_OPENCLAW_AGENT_ID=business-coordinator
# CRM investigation can require several tool rounds and a long final synthesis.
BC_OPENCLAW_TIMEOUT_SECONDS=300
# Optional legacy offline sales harness, not the production runtime.
SALES_LLM_MODEL=YOUR_TOOL_CAPABLE_MODEL
SALES_LLM_BASE_URL=https://YOUR_PROVIDER_API/v1
SALES_LLM_API_KEY=YOUR_API_KEY

# Optional public-event search. Disabled until explicitly enabled; may consume search credits.
# Independent of Bedrock/OpenClaw credentials. Never expose this key to the browser.
BC_ENABLE_WEB_SEARCH=0
TAVILY_API_KEY=

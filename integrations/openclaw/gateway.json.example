{
  "gateway": {
    "bind": "loopback",
    "http": { "endpoints": { "chatCompletions": { "enabled": true } } }
  },
  "agents": {
    "entries": {
      "business-coordinator": {
        "name": "SME Business Coordinator",
        "skills": [],
